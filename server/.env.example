# AppControl Studio — Server Environment Variables
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# MSAL Authentication (Azure AD) — server-side JWT validation
# Must match the values set in the client .env.
# Leave these unset to skip MSAL JWT validation (existing RBAC applies).
# ---------------------------------------------------------------------------

# Directory (tenant) ID from your Azure AD app registration
MSAL_TENANT_ID=

# Application (client) ID from your Azure AD app registration
MSAL_CLIENT_ID=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API server listens on (default: 3001)
PORT=3001

# Allowed CORS origin for the Vite dev server (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173
