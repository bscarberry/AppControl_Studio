# AppControl Studio — Client Environment Variables
# Copy this file to .env (or .env.local) and fill in your values.
# Variables prefixed with VITE_ are exposed to the browser bundle.

# ---------------------------------------------------------------------------
# MSAL Authentication (Azure AD)
# Leave these unset to run without authentication (local workstation mode).
# ---------------------------------------------------------------------------

# Application (client) ID from your Azure AD app registration
VITE_MSAL_CLIENT_ID=

# Directory (tenant) ID from your Azure AD app registration
VITE_MSAL_TENANT_ID=

# Redirect URI registered in your Azure AD app (defaults to window.location.origin)
# Must be listed under "Redirect URIs" in the app registration.
# Example for local dev: http://localhost:5173
VITE_MSAL_REDIRECT_URI=
