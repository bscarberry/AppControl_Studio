<?xml version="1.0" encoding="utf-8"?>
<!--
  Sample WDAC Policy — AppControl Studio
  This is a minimal, well-formed SiPolicy XML file for testing.
  It does NOT represent a secure production policy.
-->
<SiPolicy
  xmlns="urn:schemas-microsoft-com:sipolicy"
  PolicyID="{A244370E-44C9-4C06-B551-F6016E563076}"
  BasePolicyID="{A244370E-44C9-4C06-B551-F6016E563076}"
  FriendlyName="AppControl Studio Sample Policy"
  VersionEx="10.0.0.1"
  PlatformID="{2E07F7E4-194C-4D20-B96C-134F72D89D7E}"
  HvciOptions="0">

  <Rules>
    <Rule>
      <Option>Enabled:UMCI</Option>
    </Rule>
    <Rule>
      <Option>Enabled:Audit Mode</Option>
    </Rule>
    <Rule>
      <Option>Enabled:Unsigned System Integrity Policy</Option>
    </Rule>
    <Rule>
      <Option>Enabled:Advanced Boot Options Menu</Option>
    </Rule>
  </Rules>

  <EKUs>
    <EKU ID="ID_EKU_WINDOWS" FriendlyName="Windows System Component Verification" Value="010a2b0601040182370a0306" />
    <EKU ID="ID_EKU_ELAM" FriendlyName="Windows ELAM Driver Verification" Value="010a2b0601040182374f0105" />
    <EKU ID="ID_EKU_HAL_EXT" FriendlyName="HAL Extension" Value="010a2b0601040182374f0107" />
    <EKU ID="ID_EKU_WHQL" FriendlyName="Windows Hardware Quality Labs (WHQL)" Value="010a2b0601040182370a0305" />
    <EKU ID="ID_EKU_RT_EXT" FriendlyName="Windows RT Extensions" Value="010a2b0601040182374f0106" />
    <EKU ID="ID_EKU_STORE" FriendlyName="Windows Store" Value="010a2b0601040182374f0131" />
    <EKU ID="ID_EKU_DCODEGEN" FriendlyName="Dynamic Code Generator" Value="010a2b0601040182374f0147" />
    <EKU ID="ID_EKU_AM" FriendlyName="AntiMalware" Value="010a2b0601040182374f0135" />
  </EKUs>

  <FileRules>
    <!-- Hash-based allow rule for a specific binary -->
    <Allow
      ID="ID_ALLOW_NOTEPAD"
      FriendlyName="Allow notepad.exe (known good hash)"
      Hash="D9D26C24B4D6DE73B0671A3E4E0553FEF7DA25E6C9ADE03EAD86C1EF12E17F5F"
      HashType="SHA256" />

    <!-- Path-based allow rule -->
    <Allow
      ID="ID_ALLOW_WINDIR"
      FriendlyName="Allow Windows directory (path rule)"
      FilePath="%windir%\*" />

    <!-- Publisher-scoped file attribute rule -->
    <FileAttrib
      ID="ID_FILEATTRIB_CHROME"
      FriendlyName="Google Chrome version constraint"
      ProductName="Google Chrome"
      MinimumFileVersion="100.0.0.0" />

    <!-- Deny rule for a known bad hash -->
    <Deny
      ID="ID_DENY_MIMIKATZ"
      FriendlyName="Deny mimikatz (known hash)"
      Hash="A3D1E9F2B04C5E7F9A1C3D5B8E2F4A6C9B1D3E5F7A2C4B6D8E0F2A4C6B8D0E2"
      HashType="SHA256" />
  </FileRules>

  <Signers>
    <!-- Microsoft Windows signer -->
    <Signer ID="ID_SIGNER_WINDOWS_PROD_RS1" Name="Microsoft Windows Production PCA 2011">
      <CertRoot Type="TBS" Value="0BF7E97B93A4B3D7FA5B84E5A72D9AEAF6D2A02E4E6DE3B58B6A04D2E1F3C5A7" />
      <CertEKU ID="ID_EKU_WINDOWS" />
    </Signer>

    <!-- Microsoft Windows driver signer -->
    <Signer ID="ID_SIGNER_WHQL_PROD" Name="Microsoft Windows WHQL Driver (Production)">
      <CertRoot Type="TBS" Value="1C3D5B8E2F4A6C9B1D3E5F7A2C4B6D8E0F2A4C6B8D0E2F4A6C8B0D2E4F6A8C0" />
      <CertEKU ID="ID_EKU_WHQL" />
    </Signer>

    <!-- Third-party publisher signer -->
    <Signer ID="ID_SIGNER_GOOGLE" Name="Google LLC">
      <CertRoot Type="TBS" Value="7E2D4A6C8B0E2F4A6C8B0D2E4F6A8C0D2E4F6A8C0D2E4F6A8C0D2E4F6A8C0D2" />
      <CertPublisher Value="Google LLC" />
      <FileAttribRef RuleID="ID_FILEATTRIB_CHROME" />
    </Signer>
  </Signers>

  <SigningScenarios>
    <!-- Kernel Mode Signing Scenario (Value=131) -->
    <SigningScenario Value="131" ID="ID_SIGNINGSCENARIO_DRIVERS_1" MinimumHashAlgorithm="65536">
      <ProductSigners>
        <AllowedSigners>
          <AllowedSigner SignerId="ID_SIGNER_WINDOWS_PROD_RS1" />
          <AllowedSigner SignerId="ID_SIGNER_WHQL_PROD" />
        </AllowedSigners>
        <DeniedSigners />
        <FileRulesRef />
      </ProductSigners>
    </SigningScenario>

    <!-- User Mode Signing Scenario (Value=12) -->
    <SigningScenario Value="12" ID="ID_SIGNINGSCENARIO_WINDOWS">
      <ProductSigners>
        <AllowedSigners>
          <AllowedSigner SignerId="ID_SIGNER_WINDOWS_PROD_RS1" />
          <AllowedSigner SignerId="ID_SIGNER_GOOGLE" />
        </AllowedSigners>
        <DeniedSigners />
        <FileRulesRef>
          <FileRuleRef RuleID="ID_ALLOW_NOTEPAD" />
          <FileRuleRef RuleID="ID_ALLOW_WINDIR" />
          <FileRuleRef RuleID="ID_DENY_MIMIKATZ" />
        </FileRulesRef>
      </ProductSigners>
    </SigningScenario>
  </SigningScenarios>

  <UpdatePolicySigners>
    <UpdatePolicySigner SignerId="ID_SIGNER_WINDOWS_PROD_RS1" />
  </UpdatePolicySigners>

  <CiSigners>
    <CiSigner SignerId="ID_SIGNER_WINDOWS_PROD_RS1" />
  </CiSigners>

</SiPolicy>
